{
  "data": {
    "root_dir": "../data/coco",
    "split": "train",
    "val_split": "val",
    "test_split": "test",
    "target_size": [360, 480],
    "batch_size": 8,
    "num_workers": 4,
    "min_area": 100,
    "mode": "semantic"
  },
  "model": {
    "name": "unet",
    "num_classes": 2
  },
  "training": {
    "max_epochs": 30,
    "learning_rate": 0.0001,
    "weight_decay": 0.00001,
    "early_stopping_patience": 10,
    "checkpoint_save_top_k": 3,
    "checkpoint_monitor": "val_loss",
    "checkpoint_mode": "min",
    "checkpoint_dirpath": "../checkpoints_coco_unet",
    "checkpoint_filename": "unet_coco_{epoch:02d}_{val_loss:.4f}",
    "log_dir": "../logs",
    "experiment_name": "unet_coco",
    "log_every_n_steps": 10
  },
  "hardware": {
    "accelerator": "gpu",
    "devices": 1
  }
}
