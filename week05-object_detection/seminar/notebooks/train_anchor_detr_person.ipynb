    "    num_patterns=NUM_PATTERNS,\n",
    "    pretrained=PRETRAINED\n",
    ")\n",
    "\n",
    "lightning_module = DetectionModule(\n",
    "    model=model,\n",
    "    num_classes=NUM_CLASSES,\n",
    "    learning_rate=LEARNING_RATE,\n",
    "    weight_decay=WEIGHT_DECAY,\n",
